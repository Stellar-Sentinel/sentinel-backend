# Public Stellar testnet endpoints; use matching Horizon/RPC URLs for other networks.
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Current Stellar Sentinel contract instance on Testnet; replace for other deployments.
CONTRACT_ID=CCZAAZ3FJ7LKZA7E7A6EKQTU2HCNVI3YUVIHKWHSULGZSWAJFS2D2XVX

ENVIRONMENT=development
REQUEST_TIMEOUT_SECONDS=8.0
OPERATION_SCAN_LIMIT=200
ACTIVITY_WINDOW_DAYS=7
RISK_ACTIVITY_BURST_MIN_OPERATIONS=50
RISK_ACTIVITY_BURST_POINTS=25
RISK_TRANSFER_VOLUME_XLM_THRESHOLD=10000
RISK_TRANSFER_VOLUME_POINTS=25
RISK_COUNTERPARTY_MIN_COUNT=20
RISK_COUNTERPARTY_POINTS=25
RISK_LOW_SEQUENCE_MAX=5
RISK_LOW_SEQUENCE_POINTS=15
RISK_HIGH_SCORE_THRESHOLD=70
RISK_ELEVATED_SCORE_THRESHOLD=40
EVENTS_LOOKBACK_LEDGERS=50000
CORS_ORIGINS=http://localhost:3000
SCREENING_RATE_LIMIT_REQUESTS=30
SCREENING_RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated proxy IPs/CIDRs. Leave empty unless the API is behind a known proxy.
TRUSTED_PROXY_CIDRS=
EVENT_STORE_PATH=./data/events.sqlite3
EVENT_INGEST_INTERVAL_SECONDS=30

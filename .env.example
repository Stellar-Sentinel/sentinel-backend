# Public Stellar testnet endpoints; use matching Horizon/RPC URLs for other networks.
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Current Stellar Sentinel contract instance on Testnet; replace for other deployments.
CONTRACT_ID=CCZAAZ3FJ7LKZA7E7A6EKQTU2HCNVI3YUVIHKWHSULGZSWAJFS2D2XVX

ENVIRONMENT=development
REQUEST_TIMEOUT_SECONDS=8.0
UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_BACKOFF_SECONDS=0.2
UPSTREAM_RETRY_AFTER_CAP_SECONDS=2.0
OPERATION_SCAN_LIMIT=200
ACTIVITY_WINDOW_DAYS=7
EVENTS_LOOKBACK_LEDGERS=50000
CORS_ORIGINS=http://localhost:3000
